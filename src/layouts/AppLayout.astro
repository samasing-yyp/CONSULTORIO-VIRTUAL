---
/** Páginas de la zona con sesión (/app/…): guardián, noindex, encabezado y aviso. */
import BaseLayout from './BaseLayout.astro';
import AppHeader from '../components/AppHeader.astro';
import AppNotice from '../components/AppNotice.astro';
import Footer from '../components/Footer.astro';
import '../styles/pages/app.css';

interface Props {
  title: string;
  description?: string;
  active?: string;
  footer?: boolean;
}
const { title, description, active, footer = true } = Astro.props;
---
<BaseLayout title={title} description={description} auth>
  <AppHeader active={active} />
  <AppNotice />
  <slot />
  {footer && <Footer />}
</BaseLayout>
